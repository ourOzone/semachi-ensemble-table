# 의존성
node_modules

# 빌드 산출물
build
dist

# 테스트
coverage

# 환경변수
# - 루트 .env: 백엔드(apps/server) 전용, 비밀값 포함 → 커밋 금지
# - apps/web/env/.env: 웹 공개 설정 → 커밋
# - *.local: 개인 설정 → 커밋 금지
.env
.env.*
!apps/web/env/.env
!apps/web/env/.env.development
!apps/web/env/.env.production
!apps/web/env/.env.test
!apps/web/env/.env.localserver

# 로그
*.log

# OS / 에디터
.DS_Store
Thumbs.db

# Claude Code 로컬 설정
.claude/settings.local.json
CLAUDE.local.md

# 배포(deploy/): 서버에서 채우는 비밀값 파일·이미지 이름·DB 백업 (틀은 *.env.example만 커밋)
deploy/*.env
deploy/.env.previous
deploy/backups/

# 서버: 개발용 메모리 DB 데이터(pnpm dev:server), 활동 로그 파일
apps/server/.dev-db/
apps/server/log.txt
