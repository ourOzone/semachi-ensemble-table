{
  // B-3 ①: 서버 코드(src)는 아직 JavaScript. 다음 커밋에서 TypeScript로 옮긴다
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": true,
    "types": ["node"]
  },
  "include": ["src", "test", "vitest.config.mts"]
}
