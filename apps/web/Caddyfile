# 웹 이미지 안의 Caddy 설정 (백엔드 개편 B-11, apps/web/Dockerfile)
# 빌드한 웹 파일(/srv)을 HTTP 80으로 준다. HTTPS·주소 나누기·/api는 앞의 Caddy(deploy/caddy/Caddyfile)가 한다
{
	# 이 Caddy는 컨테이너 안에서만 쓰여 HTTPS·관리 API가 필요 없다
	auto_https off
	admin off
}

:80 {
	root * /srv

	# 파일 이름에 내용 해시가 붙은 파일(Vite 빌드의 /assets/*)은 1년 캐시: 내용이 바뀌면 이름이 바뀐다.
	# 없으면 404 (배포 전에 열어 둔 탭이 지난 파일을 찾을 때 index.html을 JS로 받지 않게)
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# 그 밖(index.html 등)은 매번 새것인지 확인: 배포하면 바로 새 화면.
	# 없는 파일이면 index.html (화면 주소 /admin 등은 웹이 그린다: SPA)
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
