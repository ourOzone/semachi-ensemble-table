# 베타 api 컨테이너의 비밀값 (백엔드 개편 B-11). 서버의 /srv/semachi/beta.env 로 복사해 값을 채운다
# 운영과 같은 DB를 쓴다 (사전 결정 10): 베타에서 지우면 실제로 지워진다
# 값에 $ 가 있으면 작은따옴표로 감싼다. APP_ENV 등은 compose.yaml에 정해져 있다

MONGO_DB=
MASTER_PIN=

# 베타 기간(옛 api.js가 아직 운영 중)에는 false: 옛 서버가 평문 PIN으로 비교한다 (사전 결정 10).
# 운영 전환(B-14)에서 PIN을 해시로 바꾼 뒤 true로
PIN_HASH=false

LOG_LEVEL=info
