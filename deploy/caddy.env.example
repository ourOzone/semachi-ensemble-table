# 맨 앞 Caddy의 설정값 (백엔드 개편 B-11). 서버의 /srv/semachi/caddy.env 로 복사해 값을 채운다
# 바꾼 뒤에는 Caddy를 다시 만들어야 읽는다: docker compose up -d --force-recreate caddy

# 서비스 주소 (비워 두면 semachi.net·beta.semachi.net)
#PROD_SITE=semachi.net
# www로 오면 semachi.net으로 보낸다
#PROD_WWW_SITE=www.semachi.net
#BETA_SITE=beta.semachi.net

# 베타 기간(B-13~B-14 전): semachi.net의 웹 화면을 옛 웹(호스트의 8080, pm2 index-prod)으로 넘긴다.
# 운영 전환(B-14) 때 이 줄을 지우고 docker compose up -d caddy → 새 웹(web 컨테이너)
PROD_WEB_UPSTREAM=host.docker.internal:8080

# 베타 기본 인증: 테스터에게 알려 줄 아이디와, 암호의 해시 (암호 자체는 적지 않는다)
# 해시 만들기: docker run --rm -it caddy:2 caddy hash-password  (암호를 두 번 묻는다. 명령 기록에 암호가 남지 않게)
# 해시에는 $ 가 들어 있어 꼭 작은따옴표로 감싼다
BETA_AUTH_USER=tester
BETA_AUTH_HASH=''
