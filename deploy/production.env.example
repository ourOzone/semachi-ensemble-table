# 운영 api 컨테이너의 비밀값 (백엔드 개편 B-11). 서버의 /srv/semachi/production.env 로 복사해 값을 채운다
# 이 틀(.example)만 저장소에 있다. 채운 파일은 서버에만 두고 GitHub·채팅·스크린샷에 올리지 않는다
# 값에 $ 가 있으면 작은따옴표로 감싼다 (예: KEY='a$b'). 감싸지 않으면 docker compose가 $b를 변수로 읽는다
# APP_ENV·PORT·TZ·TRUST_PROXY·CLEANUP_ENABLED는 compose.yaml에 정해져 있다

# MongoDB 연결 주소 (지금 서버의 .env에 있는 MONGO_DB 값 그대로. Atlas면 mongodb+srv://...)
MONGO_DB=

# 마스터 PIN (관리자 화면에서 바꾸면 DB 값을 쓴다. 이것은 DB에 값이 없을 때만)
MASTER_PIN=

# 새 PIN을 해시로 저장 (B-6). 운영 전환(B-14) 때부터 true. 그 전에는 옛 서버가 같은 DB를 평문으로 읽는다
PIN_HASH=true

# 운영 로그 수준 (fatal·error·warn·info·debug)
LOG_LEVEL=info
