{
  "name": "semachi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @semachi/web dev",
    "dev:server": "pnpm --filter @semachi/server dev",
    "dev:local": "pnpm --filter @semachi/web dev:local",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter @semachi/web test",
    "test:run": "pnpm -r --if-present test:run",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
